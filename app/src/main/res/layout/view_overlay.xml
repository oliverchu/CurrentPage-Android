<?xml version="1.0" encoding="utf-8"?>
<!-- 贴屏幕左缘的卡片：左侧品牌色细条（3dp）+ 右侧圆角。
     拖拽手柄是卡片内部的一个 View，随卡片一起绘制/平移（不再单开可见窗口）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:minWidth="190dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/overlay_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="200dp"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="9sp"
            android:textDirection="ltr"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/overlay_class"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:maxWidth="200dp"
            android:textColor="@color/overlay_text_primary"
            android:textSize="11sp"
            android:textDirection="ltr" />
    </LinearLayout>

    <!-- 导航指示线风格的拖拽手柄（视觉部分，跟随卡片整体运动） -->
    <View
        android:id="@+id/overlay_dragbar"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_overlay_dragbar" />

</FrameLayout>
